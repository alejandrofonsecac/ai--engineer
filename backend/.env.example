# Servidor
VRE_HOST=127.0.0.1
VRE_PORT=8000
VRE_DATABASE_PATH=data/virtual_race_engineer.db

# Ollama local
VRE_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Perfil inicial recomendado: llama3.2 (3B).
# Use qwen3:4b ou um modelo maior caso queira testar outra opção local.
VRE_OLLAMA_MODEL=llama3.2
VRE_OLLAMA_TIMEOUT_SECONDS=90
