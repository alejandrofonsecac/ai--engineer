# API local; .env sempre é lido da pasta backend.
VRE_DATABASE_PATH=data/virtual_race_engineer.db
VRE_OLLAMA_BASE_URL=http://127.0.0.1:11434
VRE_OLLAMA_MODEL=qwen2.5:3b
# Versão usada para consultar o catálogo de limites (não inferida do JSON).
VRE_ACC_GAME_VERSION=1.10.3

# Perfil inicial para i3-10100F / RX 6600, para avaliar junto com ACC.
VRE_OLLAMA_TEMPERATURE=0.2
VRE_OLLAMA_NUM_CTX=4096
VRE_OLLAMA_NUM_PREDICT=700
VRE_OLLAMA_KEEP_ALIVE=5m
VRE_OLLAMA_TIMEOUT_SECONDS=180
